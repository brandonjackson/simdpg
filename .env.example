# SimDPG environment example
# Copy to `.env` and adjust values as needed.

# ---------------------------------------------------------------------------
# Core local URLs (used by portal + simulation; override defaults if needed)
# ---------------------------------------------------------------------------
PORTAL_URL=http://localhost:3000
IDENTITY_URL=http://localhost:3001
CIVIL_REGISTRY_URL=http://localhost:3002
HEALTH_URL=http://localhost:3003
BENEFITS_URL=http://localhost:3004
NOTIFICATIONS_URL=http://localhost:3005
PAYMENTS_URL=http://localhost:3006
SOCIAL_REGISTRY_URL=http://localhost:3007

# ---------------------------------------------------------------------------
# Form webhook legacy fallbacks (used when no URL is registered in /api/form-webhooks)
# ---------------------------------------------------------------------------
OPENFN_NATIONAL_ID_WEBHOOK_URL=
OPENFN_MARRIAGE_REGISTRATION_WEBHOOK_URL=
OPENFN_BENEFIT_ELIGIBILITY_PART1_URL=
OPENFN_BENEFIT_ELIGIBILITY_PART2_URL=
OPENFN_BENEFIT_ELIGIBILITY_PART3_URL=

# ---------------------------------------------------------------------------
# Catch-all event webhook fallback on each system (optional)
# ---------------------------------------------------------------------------
WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Simulation controls
# ---------------------------------------------------------------------------
POPULATION_SIZE=100
CONCURRENCY=5
YEARS=1
APPLICATIONS=10

# ---------------------------------------------------------------------------
# Payments gateway simulation
# 1 = disable random simulated gateway failures
# ---------------------------------------------------------------------------
PAYMENTS_DISABLE_FAILURES=0

# ---------------------------------------------------------------------------
# Simulation / portal persistence paths (optional)
# ---------------------------------------------------------------------------
SIM_DATA_DIR=
PORTAL_DB_FILE=

# ---------------------------------------------------------------------------
# Simulation worker execution overrides (optional)
# ---------------------------------------------------------------------------
SIM_WORKER_CMD=npx
SIM_WORKER_ENTRY=simulation/src/index.ts

# ---------------------------------------------------------------------------
# Service runtime (usually set by each service / platform)
# ---------------------------------------------------------------------------
PORT=
SIMDPG_NO_LISTEN=0

# ---------------------------------------------------------------------------
# Railway-specific (optional, used for private host URL derivation)
# ---------------------------------------------------------------------------
RAILWAY_ENVIRONMENT_NAME=
RAILWAY_PRIVATE_DOMAIN=
