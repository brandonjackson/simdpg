{
  "name": "@simdpg/system-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "//exports": "./behavior is the dependency-free config half of the stochastic-behaviour feature (no express), so the portal's browser bundle can import the presets and field registry for the simulation config screen.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./behavior": {
      "types": "./dist/behavior.d.ts",
      "default": "./dist/behavior.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "express": "^4.21.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/uuid": "^10.0.0",
    "vitest": "^2.1.0"
  }
}
